{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": { "includeFiles": "server/{postgres-schema.sql,supabase-ca.crt}" }
  },
  "routes": [
    { "src": "/api(?:/.*)?$", "dest": "/api/index" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
